{
  "name": "basket",
  "version": "1.0.0",
  "private": true,
  "description": "Basket: a shared shopping list for two, built with Firebase + Capacitor",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.4.3",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/preferences": "7.0.4",
    "@capacitor/status-bar": "7.0.6",
    "@fontsource-variable/inter": "5.3.0",
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@types/node": "22.15.30",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
